#!/usr/bin/env bash
set -e
if [[ ! -d "/home/xarwex/repos/esp32-moisture-meter" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/home/xarwex/repos/esp32-moisture-meter")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/home/xarwex/repos/esp32-moisture-meter" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/home/xarwex/repos/esp32-moisture-meter/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/home/xarwex/repos/esp32-moisture-meter/.envrc" "/home/xarwex/repos/esp32-moisture-meter/.direnv"/*.rc
